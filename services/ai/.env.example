PORT=8000

# Azure OpenAI — same resource the NestJS backend uses today.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

# Shared secret required on every request from the NestJS backend. The service has no
# user model of its own — this only proves the caller is our API, not the open internet.
AI_SERVICE_TOKEN=

# Ceiling on concurrent Azure OpenAI calls. Ported from the NestJS implementation, where
# load testing showed 24 concurrent users pushing single-call latency to 40-105s.
AI_CONCURRENCY_LIMIT=6
AI_QUEUE_MAX_WAIT_MS=25000
